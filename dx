            local function scanTargets(targets)
                for _, target in ipairs(targets) do
                    for _, child in pairs(target.parent:GetChildren()) do
                        if target.name then
                            if child.Name == target.name then
                                cleanup(child)
                            end
                        elseif target.patterns then
                            if child:IsA("LocalScript") then
                                for _, pattern in ipairs(target.patterns) do
                                    if string.match(child.Name, pattern) then
                                        cleanup(child)

                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end

            local function buildTargets()
                local targets = {}
                local feFolder = workspace:FindFirstChild("FE")
                local feSettings = feFolder
                    and feFolder:FindFirstChild("Settings")

                if feSettings then
                    targets[#targets + 1] = {
                        parent = feSettings,
                        name = "BName",
                    }

                    targets[#targets + 1] = {
                        parent = feSettings,
                        name = "AssetCheck",
                    }
                end

                local feSystem = feFolder
                    and feFolder:FindFirstChild("System")

                if feSystem then
                    targets[#targets + 1] = {
                        parent = feSystem,
                        name = " ",
