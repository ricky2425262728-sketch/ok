                local dummyKeepYourHeadUp = Instance.new("RemoteEvent")

                dummyKeepYourHeadUp.Name = keepYourHeadUp.Name
                dummyKeepYourHeadUp.Parent = system
                keepYourHeadUp:Destroy()

                local dummyHelloWorld = Instance.new("RemoteEvent")

                dummyHelloWorld.Name = helloWorld.Name
                dummyHelloWorld.Parent = system
                helloWorld:Destroy()
            end)
