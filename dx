                local feFolder = workspace:WaitForChild("FE", 15)
                local system = feFolder
                    and feFolder:FindFirstChild("System")

                if not system then
                    warn("[BXW DEBUG] Missing object: workspace.FE or workspace.FE.System - skipping remote replacement")

                    return
