                        parent = LocalPlayer.Character,
                        name = " ",
                    }
                end

                local starterGui = game:FindFirstChild("StarterGui")
                local startScreen = starterGui
                    and starterGui:FindFirstChild("Start")

                if startScreen then
                    targets[#targets + 1] = {
                        parent = startScreen,
